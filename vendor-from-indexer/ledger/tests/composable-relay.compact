include "std";

ledger burn_contract: ContractAddress;
ledger tmp_ep_comm: Bytes<32>;

witness tmp_do_call(coin: CoinInfo): [];
witness tmp_call_rand(): Field;

export circuit send_to_burn(coin: CoinInfo): [] {
  receive(coin);
  // The -1 is a work around for PM-11279.
  // This should be removable on the next compiler release, but this did not
  // seem sufficient justification to bump the compiler pulled in.
  const send_value = coin.value == 0 ? 0 : coin.value - 1;
  const res = send_immediate(coin, right<ZswapCoinPublicKey, ContractAddress>(burn_contract), send_value);
  tmp_do_call(res.sent);
  const cc = transient_commit<CoinInfo>(res.sent, tmp_call_rand());
  kernel.claim_contract_call(burn_contract.bytes, tmp_ep_comm, cc);
}
