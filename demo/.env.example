# Published release-candidate images. Override these to use locally built images.
RESOLVER_IMAGE=ghcr.io/midnightntwrk/midnight-did-resolver-service:0.1.0-rc.2
MANAGER_IMAGE=ghcr.io/midnightntwrk/midnight-did-manager-service:0.1.0-rc.2

# Host ports for the two applications.
RESOLVER_PORT=3001
MANAGER_PORT=3010

# Manager state is persisted on the host between demo runs.
MANAGER_DATA_DIR=${HOME}/.midnight-did/manager

# Optional overrides for the local Midnight infrastructure.
PROOF_SERVER_IMAGE=midnightntwrk/proof-server:8.0.3
INDEXER_IMAGE=midnightntwrk/indexer-standalone:4.0.0
NODE_IMAGE=midnightntwrk/midnight-node:0.22.3
