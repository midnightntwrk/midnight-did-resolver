# Environment variables for the standalone indexer container.
# These are dev defaults for local use only.

# Local-only container network; TLS terminates outside this standalone stack.
APP__INFRA__NODE__URL=ws://node:9944 # nosemgrep: javascript.lang.security.detect-insecure-websocket.detect-insecure-websocket
APP__INFRA__STORAGE__PASSWORD=indexer
APP__INFRA__PUB_SUB__PASSWORD=indexer
APP__INFRA__LEDGER_STATE_STORAGE__PASSWORD=indexer
# Public deterministic test fixture required by the standalone indexer.
APP__INFRA__SECRET=303132333435363738393031323334353637383930313233343536373839303132 # nosemgrep: generic.secrets.security.detected-generic-secret.detected-generic-secret
