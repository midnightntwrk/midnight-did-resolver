{
  "name": "@midnight-ntwrk/midnight-did-secret-storage",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm -C ../.. run build:did-jubjub-schnorr",
    "build": "rm -rf dist && tsc -b tsconfig.build.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm -C ../.. run build:did-jubjub-schnorr",
    "test": "vitest run -c vitest.config.ts --passWithNoTests",
    "test:ci": "pnpm run test",
    "precoverage": "pnpm -C ../.. run build:did-jubjub-schnorr",
    "coverage": "vitest run -c vitest.config.ts --coverage",
    "clean": "rm -rf dist && rm -rf coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-did-jubjub-schnorr": "file:../../libs/midnight-did/midnight-ntwrk-midnight-did-jubjub-schnorr-0.2.0.tgz",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.0",
    "circomlibjs": "^0.1.7",
    "zod": "^4.1.0"
  },
  "files": [
    "dist/**",
    "README.md",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ]
}
