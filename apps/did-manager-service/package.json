{
  "name": "@midnight-ntwrk/midnight-did-manager-service",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepare:deps": "pnpm -C ../.. run build:did-prereqs && pnpm -C ../.. --filter @midnight-ntwrk/midnight-did-secret-storage build",
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -b tsconfig.build.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prebuild": "pnpm run prepare:deps",
    "pretest": "pnpm run prepare:deps",
    "pretest:e2e": "pnpm run build",
    "pretest:e2e:standalone": "pnpm run build",
    "pretest:e2e:preprod": "pnpm run build",
    "test:e2e": "playwright test",
    "test:e2e:standalone": "playwright test src/e2e/manager.spec.ts",
    "test:e2e:preprod": "playwright test src/e2e/preprod-funding.spec.ts",
    "playwright:install": "playwright install chromium",
    "coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "start": "node --experimental-specifier-resolution=node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@midnight-ntwrk/midnight-did": "file:../../libs/midnight-did/midnight-ntwrk-midnight-did-0.2.0.tgz",
    "@midnight-ntwrk/midnight-did-api": "file:../../libs/midnight-did/midnight-ntwrk-midnight-did-api-0.2.0.tgz",
    "@midnight-ntwrk/midnight-did-secret-storage": "workspace:*",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.0.2",
    "@midnight-ntwrk/midnight-js-network-id": "^4.0.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "^3.1.0",
    "canonicalize": "^3.0.0",
    "fastify": "^5.6.1",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
