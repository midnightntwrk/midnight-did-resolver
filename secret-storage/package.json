{
  "name": "@midnight-ntwrk/midnight-did-secret-storage",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm --prefix .. run build:did-jubjub-schnorr",
    "build": "rm -rf dist && tsc -b tsconfig.build.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm --prefix .. run build:did-jubjub-schnorr",
    "test": "vitest run -c vitest.config.ts --passWithNoTests",
    "test:ci": "npm run test",
    "precoverage": "npm --prefix .. run build:did-jubjub-schnorr",
    "coverage": "vitest run -c vitest.config.ts --coverage",
    "clean": "rm -rf dist && rm -rf coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-did-domain": "1.0.0-rc1",
    "@midnight-ntwrk/midnight-did-jubjub-schnorr": "1.0.0-rc1",
    "@midnight-ntwrk/wallet-sdk-hd": "4.0.0",
    "zod": "^4.6.7",
    "@midnightntwrk/ledger-v9": "1.0.0"
  },
  "files": [
    "dist/**",
    "README.md",
    "package.json",
    "tsconfig.json",
    "tsconfig.build.json"
  ]
}
